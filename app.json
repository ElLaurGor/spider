{
  "expo": {
    "name": "S.P.I.D.E.R",
    "slug": "spider",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spider",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090F",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "app.spider.assistant",
      "adaptiveIcon": {
        "backgroundColor": "#07090F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E23636"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "S.P.I.D.E.R. reads your calendar to plan your day and stay quiet during meetings."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      [
        "expo-image-picker",
        {
          "cameraPermission": "S.P.I.D.E.R. uses the camera for meal photos and gym progress pics.",
          "photosPermission": "S.P.I.D.E.R. lets you pick meal and progress photos from your gallery.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "S.P.I.D.E.R. uses the camera to scan food barcodes, meal photos and progress pics.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sharing",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7425746-9a63-49f6-96b6-3259ceb27e9e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/a7425746-9a63-49f6-96b6-3259ceb27e9e"
    }
  }
}
